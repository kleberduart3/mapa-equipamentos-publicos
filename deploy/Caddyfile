# HTTPS automático (Let's Encrypt) para os dois endereços:
#   MAPA_DOMINIO_SITE  equicidade.com.br       landing page (opcional; hoje no GitHub Pages)
#   MAPA_DOMINIO       mapa.equicidade.com.br  a ferramenta (login, mapa, API)
# (Opcional) e-mail para avisos do Let's Encrypt: descomente e preencha MAPA_EMAIL_CERTIFICADO no .env.
# {
# 	email {$MAPA_EMAIL_CERTIFICADO}
# }

(app) {
	reverse_proxy app:8000 {
		transport http {
			read_timeout 5m
		}
	}
}

(cabecalhos_site) {
	header {
		-Server
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}
}

# ---------------------------------------------------------------- landing page (opcional)
# Hoje a landing é publicada pelo GitHub Pages (repositório equicidade-site), com o DNS de
# equicidade.com.br apontando para o GitHub. Para servir a landing por este servidor, aponte o
# DNS para a VPS, defina MAPA_DOMINIO_SITE no .env e tire o # das linhas abaixo.
# {$MAPA_DOMINIO_SITE} {
# 	encode zstd gzip
# 	import cabecalhos_site
# 	root * /srv/landing
# 	@estaticos path /assets/* /favicon* /apple-touch-icon.png
# 	header @estaticos Cache-Control "public, max-age=604800"
# 	file_server
# 	log {
# 		output stdout
# 		format json
# 	}
# }
#
# www.{$MAPA_DOMINIO_SITE} {
# 	redir https://{$MAPA_DOMINIO_SITE}{uri} permanent
# }
#

# ---------------------------------------------------------------- ferramenta
{$MAPA_DOMINIO} {
	encode zstd gzip
	header -Server
	log {
		output stdout
		format json
	}

	# Corpo das requisições: até 210 MB só no envio do cadastro do IPTU; 1 MB no resto.
	# (handle é exclusivo: cada requisição cai em um bloco só.)
	@upload path_regexp ^/api/[0-9]{7}/upload-iptu$
	handle @upload {
		request_body {
			max_size 210MB
		}
		import app
	}
	handle {
		request_body {
			max_size 1MB
		}
		import app
	}
}
