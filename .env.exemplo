# Copie para .env (NUNCA versione o .env) e preencha.

# Domínios (sem https://) e e-mail para os certificados HTTPS
# landing page:
MAPA_DOMINIO_SITE=equicidade.com.br
# a ferramenta (login e mapa):
MAPA_DOMINIO=mapa.equicidade.com.br
MAPA_EMAIL_CERTIFICADO=voce@seudominio.com.br

# Endereço público completo da ferramenta (links de convite e proteção CSRF)
MAPA_URL_BASE=https://mapa.equicidade.com.br

# E-mail para convites e "esqueci a senha" (opcional; sem isto, o admin copia os links)
# MAPA_SMTP_HOST=smtp-relay.brevo.com
# MAPA_SMTP_PORTA=587
# MAPA_SMTP_USUARIO=
# MAPA_SMTP_SENHA=
# MAPA_SMTP_REMETENTE=Mapa de Equipamentos <nao-responda@seudominio.com.br>

# Ajustes opcionais (padrões entre parênteses)
# MAPA_SESSAO_OCIOSA_HORAS=12
# MAPA_SESSAO_MAX_DIAS=7
# MAPA_LOGIN_FALHAS_BLOQUEIO=5
# MAPA_PDF_POR_USUARIO_HORA=10

# Mapa de fundo (produção): provedor contratado, URL raster com {z}/{x}/{y} e a chave
# MAPA_MOSAICOS_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=SUA_CHAVE
# MAPA_MOSAICOS_ATRIBUICAO=© MapTiler © OpenStreetMap contributors
